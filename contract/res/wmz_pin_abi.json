            "block_timestamp_ns",
            "day",
            "leaf_count",
            "merkle_root"
          ],
          "properties": {
            "block_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "block_timestamp_ns": {
              "description": "Nanoseconds as a decimal string: too big for a JSON number to hold safely.",
              "type": "string"
            },
            "day": {
              "type": "string"
            },
            "leaf_count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "merkle_root": {
              "type": "string"
            },
            "prev_pin": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
