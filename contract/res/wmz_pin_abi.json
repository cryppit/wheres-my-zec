          "serialization_type": "json",
          "type_schema": {
            "anyOf": [
              {
                "$ref": "#/definitions/Pin"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      {
        "name": "new",
        "doc": " One-time setup. `schema` says what the pinned roots are over, e.g. `wheres-my-zec/data@1`.",
        "kind": "call",
        "modifiers": [
          "init"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "schema",
              "type_schema": {
                "type": "string"
              }
            }
          ]
        }
      },
      {
        "name": "pin",
