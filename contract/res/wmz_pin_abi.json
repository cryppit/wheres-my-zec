              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "leaf_count",
              "type_schema": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            {
              "name": "prev_pin",
              "type_schema": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "$ref": "#/definitions/Pin"
          }
        }
      },
      {
        "name": "schema",
        "doc": " What the pinned roots are over.",
        "kind": "view",
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "type": "string"
          }
        }
      }
    ],
    "root_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "String",
      "type": "string",
      "definitions": {
        "Pin": {
          "description": "One pin: what the caller sent plus when NEAR recorded it.",
          "type": "object",
          "required": [
